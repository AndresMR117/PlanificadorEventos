DEBUG=True
SECRET_KEY=change-me

# Para correr Django localmente desde tu PC, usa el host publico de Railway.
MYSQL_PUBLIC_URL=mysql://root:password@zephyr.proxy.rlwy.net:24799/planificador_eventos
MYSQL_DATABASE=planificador_eventos
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=zephyr.proxy.rlwy.net
MYSQL_PORT=24799

# Railway puede inyectar estas variables cuando el backend corre dentro de Railway.
MYSQLDATABASE=planificador_eventos
MYSQLUSER=root
MYSQLPASSWORD=password
MYSQLHOST=mysql.railway.internal
MYSQLPORT=3306

# Apache Jena Fuseki / SPARQL. Cuando Railway te de la URL, cambia solo esto.
# Ejemplo: https://tu-fuseki.up.railway.app/eventos/sparql
SPARQL_ENDPOINT=
SPARQL_USER=
SPARQL_PASSWORD=
SPARQL_TIMEOUT=10

# Chatbot Groq. Si no tienes la key, el resto de endpoints sigue funcionando.
GROQ_API_KEY=
