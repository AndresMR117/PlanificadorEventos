# ============================================================
# FACTORES DE DISTANCIA
# ============================================================

ev:FactorLocal a ev:FactorDistancia ; ev:nombre "Local"@es ; ev:distanciaKm "20"^^xsd:decimal ; ev:multiplicador "1.0"^^xsd:decimal .
ev:FactorCercano a ev:FactorDistancia ; ev:nombre "Cercano"@es ; ev:distanciaKm "80"^^xsd:decimal ; ev:multiplicador "1.15"^^xsd:decimal .
ev:FactorMedio a ev:FactorDistancia ; ev:nombre "Medio"@es ; ev:distanciaKm "200"^^xsd:decimal ; ev:multiplicador "1.35"^^xsd:decimal .
ev:FactorLejano a ev:FactorDistancia ; ev:nombre "Lejano"@es ; ev:distanciaKm "600"^^xsd:decimal ; ev:multiplicador "1.6"^^xsd:decimal .

# ============================================================
# TEMPORADAS
# ============================================================

ev:TemporadaAlta a ev:Temporada ; ev:temporadaNombre "Alta"@es ; ev:factorTemporada "1.25"^^xsd:decimal ; ev:descripcion "Diciembre, junio, julio, Semana Santa"@es .
ev:TemporadaMedia a ev:Temporada ; ev:temporadaNombre "Media"@es ; ev:factorTemporada "1.1"^^xsd:decimal ; ev:descripcion "Marzo, agosto, septiembre, octubre"@es .
ev:TemporadaBaja a ev:Temporada ; ev:temporadaNombre "Baja"@es ; ev:factorTemporada "1.0"^^xsd:decimal ; ev:descripcion "Enero, febrero, abril, mayo, noviembre"@es .

