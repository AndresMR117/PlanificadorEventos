@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ev: <http://eventos.caqueta.co/ontologia#> .

ev: a owl:Ontology ;
    rdfs:label "Ontología de Eventos Sociales del Caquetá"@es .

# ============================================================
# CLASES PRINCIPALES
# ============================================================

ev:TipoEvento a owl:Class .           # Boda, Cumpleaños, Grado, etc.
ev:CategoriaServicio a owl:Class .    # Catering, Música, Fotografía, etc.
ev:Empresa a owl:Class .              # Proveedores
ev:Servicio a owl:Class .             # Servicios específicos
ev:Accesorio a owl:Class .            # Elementos adicionales
ev:Paquete a owl:Class .              # Paquetes combinados
ev:Ubicacion a owl:Class .            # Ciudades
ev:FactorDistancia a owl:Class .      # Factores por distancia
ev:Temporada a owl:Class .            # Temporadas del año

# ============================================================
# PROPIEDADES
# ============================================================

ev:nombre a owl:DatatypeProperty .
ev:descripcion a owl:DatatypeProperty .
ev:precioBase a owl:DatatypeProperty .
ev:precioMinimo a owl:DatatypeProperty .
ev:precioMaximo a owl:DatatypeProperty .
ev:precioPorPersona a owl:DatatypeProperty .
ev:calificacion a owl:DatatypeProperty .
ev:totalResenas a owl:DatatypeProperty .
ev:aniosExperiencia a owl:DatatypeProperty .
ev:ciudad a owl:DatatypeProperty .
ev:telefono a owl:DatatypeProperty .
ev:whatsapp a owl:DatatypeProperty .
ev:email a owl:DatatypeProperty .
ev:instagram a owl:DatatypeProperty .
ev:facebook a owl:DatatypeProperty .
ev:capacidadPersonas a owl:DatatypeProperty .
ev:duracionHoras a owl:DatatypeProperty .
ev:multiplicador a owl:DatatypeProperty .
ev:distanciaKm a owl:DatatypeProperty .
ev:factorTemporada a owl:DatatypeProperty .
ev:rangoPrecio a owl:DatatypeProperty .

ev:tieneCategoria a owl:ObjectProperty .
ev:ofrecidoPor a owl:ObjectProperty .
ev:ubicadaEn a owl:ObjectProperty .
ev:compatibleConTipo a owl:ObjectProperty .
ev:empresaAlternativa a owl:ObjectProperty .
ev:aplicaEnTemporada a owl:ObjectProperty .
ev:incluyeServicio a owl:ObjectProperty .
ev:paqueteParaTipo a owl:ObjectProperty .
ev:accesorioParaTipo a owl:ObjectProperty .

# ============================================================
# TIPOS DE EVENTO (12 tipos)
# ============================================================

ev:Boda a ev:TipoEvento ; ev:nombre "Boda"@es ; ev:descripcion "Ceremonia y celebración matrimonial."@es .
ev:Cumpleanos a ev:TipoEvento ; ev:nombre "Cumpleaños"@es ; ev:descripcion "Celebración de aniversario de nacimiento."@es .
ev:Grado a ev:TipoEvento ; ev:nombre "Grado"@es ; ev:descripcion "Celebración de graduación académica."@es .
ev:QuinceAnos a ev:TipoEvento ; ev:nombre "Quinceañera"@es ; ev:descripcion "Celebración de los 15 años."@es .
ev:BabyShower a ev:TipoEvento ; ev:nombre "Baby Shower"@es ; ev:descripcion "Fiesta de bienvenida al bebé."@es .
ev:FiestaInfantil a ev:TipoEvento ; ev:nombre "Fiesta Infantil"@es ; ev:descripcion "Celebración temática para niños."@es .
ev:Despedida a ev:TipoEvento ; ev:nombre "Despedida de Soltero"@es ; ev:descripcion "Fiesta previa al matrimonio."@es .
ev:Aniversario a ev:TipoEvento ; ev:nombre "Aniversario"@es ; ev:descripcion "Celebración de aniversario de pareja."@es .
ev:Bautizo a ev:TipoEvento ; ev:nombre "Bautizo"@es ; ev:descripcion "Ceremonia religiosa de bautismo."@es .
ev:PrimeraComunion a ev:TipoEvento ; ev:nombre "Primera Comunión"@es ; ev:descripcion "Celebración religiosa de primera comunión."@es .
ev:EventoCorporativo a ev:TipoEvento ; ev:nombre "Evento Corporativo"@es ; ev:descripcion "Eventos de empresas y negocios."@es .
ev:Conferencia a ev:TipoEvento ; ev:nombre "Conferencia"@es ; ev:descripcion "Evento académico o profesional."@es .

# ============================================================
# CATEGORÍAS DE SERVICIO (16 categorías)
# ============================================================

ev:CatDecoracion a ev:CategoriaServicio ; ev:nombre "Decoración"@es .
ev:CatCatering a ev:CategoriaServicio ; ev:nombre "Catering"@es .
ev:CatMusica a ev:CategoriaServicio ; ev:nombre "Música y Entretenimiento"@es .
ev:CatFotografia a ev:CategoriaServicio ; ev:nombre "Fotografía y Video"@es .
ev:CatLogistica a ev:CategoriaServicio ; ev:nombre "Logística"@es .
ev:CatTransporte a ev:CategoriaServicio ; ev:nombre "Transporte"@es .
ev:CatSalon a ev:CategoriaServicio ; ev:nombre "Salón y Espacio"@es .
ev:CatPasteleria a ev:CategoriaServicio ; ev:nombre "Pastelería"@es .
ev:CatIluminacion a ev:CategoriaServicio ; ev:nombre "Iluminación"@es .
ev:CatAnimacion a ev:CategoriaServicio ; ev:nombre "Animación"@es .
ev:CatInvitaciones a ev:CategoriaServicio ; ev:nombre "Invitaciones"@es .
ev:CatVestimenta a ev:CategoriaServicio ; ev:nombre "Vestimenta"@es .
ev:CatFlores a ev:CategoriaServicio ; ev:nombre "Arreglos Florales"@es .
ev:CatSeguridad a ev:CategoriaServicio ; ev:nombre "Seguridad"@es .
ev:CatSonido a ev:CategoriaServicio ; ev:nombre "Sonido"@es .
ev:CatAlquileres a ev:CategoriaServicio ; ev:nombre "Alquileres"@es .

# ============================================================
# UBICACIONES (12 ciudades del Caquetá)
# ============================================================

ev:UbicFlorencia a ev:Ubicacion ; ev:ciudad "Florencia"@es ; ev:distanciaKm "0"^^xsd:decimal .
ev:UbicSanVicente a ev:Ubicacion ; ev:ciudad "San Vicente del Caguán"@es ; ev:distanciaKm "180"^^xsd:decimal .
